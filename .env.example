# TCMB EVDS API anahtarı — OPSİYONEL.
# Proje, depoya gömülü cache/data_cache.json sayesinde anahtar OLMADAN da çalışır.
# Anahtar yalnızca verileri canlı güncellemek (EVDS'den en yeni ayları çekmek) için gerekir.
# Ücretsiz almak için: https://evds3.tcmb.gov.tr  (Üyelik > Profil > "API Anahtarı")
EVDS_API_KEY=BURAYA_API_ANAHTARINIZI_YAZIN

# TÜFE serisi (varsayılan: TÜFE Genel Endeks, 2003=100).
# Normalde değiştirmenize gerek yoktur.
EVDS_SERIES=TP.FG.J0

# Önbellek (cache) kaç saniye geçerli kalsın? (varsayılan: 12 saat)
CACHE_TTL_SECONDS=43200
